# Variables del proyecto en Vercel (ver docs/MASTER.md → Variables de entorno).
# DATABASE_URL, DATABASE_URL_UNPOOLED: las crea la integración de Neon.
# BLOB_READ_WRITE_TOKEN: la crea el almacén de Vercel Blob.
# AUTH_SECRET: firma de la cookie de sesión (48 bytes aleatorios en base64).
# SETUP_CODE: código que pide /setup la primera vez para fijar la contraseña.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BLOB_READ_WRITE_TOKEN=
AUTH_SECRET=
SETUP_CODE=
