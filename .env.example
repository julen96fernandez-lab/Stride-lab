# Copia a .env.local para desarrollo. En Vercel se configuran en el proyecto.
# Secreto para firmar la cookie de sesión (32+ caracteres): openssl rand -base64 48
AUTH_SECRET=
# Hash de la contraseña: npm run hash-password -- 'tu-contraseña'
AUTH_PASSWORD_HASH=
# Neon (paso 2)
DATABASE_URL=
# Vercel Blob (paso 4)
BLOB_READ_WRITE_TOKEN=
